# کلید Groq (از ایران معمولاً 403)
GROQ_API_KEY=
GROQ_DISABLED=true

# Gemini مستقیم گوگل (از ایران معمولاً 403)
GEMINI_API_KEY=
GEMINI_DISABLED=true

# ===== درگاه ایرانی ChatGPT/GPT (پیشنهادی) =====
# ثبت‌نام رایگان: https://avalai.ir  یا  https://ham-iran.ir
AVALAI_API_KEY=
# یا:
# HAMIRAN_API_KEY=
# OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.avalai.ir/v1
OPENAI_COMPAT_MODEL=gpt-4o-mini

# Ollama محلی (اختیاری)
OLLAMA_DISABLED=true
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=5m

PORT=8080
HOST=0.0.0.0

JWT_SECRET=change-this-to-a-random-secret-in-production
ADMIN_PASSWORD=your-admin-panel-password

CORS_ORIGINS=http://localhost:8080,http://localhost:5173
