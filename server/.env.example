# کلید Groq (اغلب از ایران 403 می‌دهد — در صورت نیاز)
GROQ_API_KEY=
GROQ_DISABLED=true

# کلید Gemini (پیشنهادی و رایگان): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ollama محلی (نیاز به RAM آزاد زیاد)
OLLAMA_DISABLED=true
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_NUM_CTX=512
OLLAMA_KEEP_ALIVE=0

PORT=8080
HOST=0.0.0.0

# امنیت — حتماً در production عوض کن
JWT_SECRET=change-this-to-a-random-secret-in-production
ADMIN_PASSWORD=your-admin-panel-password

# دامنه‌های مجاز (برای Vercel + Render)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,https://your-app.vercel.app,https://your-app.onrender.com
